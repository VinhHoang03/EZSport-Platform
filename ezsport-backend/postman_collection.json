{
  "info": {
    "name": "EZSport AI Court Suggestion API",
    "description": "Collection for testing AI-powered court suggestion features",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "AI Features",
      "item": [
        {
          "name": "1. AI Suggest Courts - Simple",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Tìm sân bóng đá giá rẻ\",\n  \"limit\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courts/ai/suggest",
              "host": ["{{baseUrl}}"],
              "path": ["courts", "ai", "suggest"]
            },
            "description": "Gợi ý sân với prompt đơn giản"
          }
        },
        {
          "name": "2. AI Suggest Courts - With Location",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Tôi muốn tìm sân cầu lông có điều hòa, giá khoảng 100-200k/giờ\",\n  \"userLat\": 21.0285,\n  \"userLng\": 105.8542,\n  \"maxDistance\": 5,\n  \"limit\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courts/ai/suggest",
              "host": ["{{baseUrl}}"],
              "path": ["courts", "ai", "suggest"]
            },
            "description": "Gợi ý sân với vị trí người dùng"
          }
        },
        {
          "name": "3. AI Suggest Courts - Complex",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Tìm sân bóng đá mini 5-7 người, có mái che, giá sinh viên dưới 300k/giờ, gần trường đại học, có dịch vụ cho thuê giày và bóng\",\n  \"userLat\": 21.0285,\n  \"userLng\": 105.8542,\n  \"maxDistance\": 3,\n  \"limit\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courts/ai/suggest",
              "host": ["{{baseUrl}}"],
              "path": ["courts", "ai", "suggest"]
            },
            "description": "Gợi ý sân với yêu cầu phức tạp"
          }
        },
        {
          "name": "4. AI Suggest Courts - Time Based",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Muốn đá bóng tối nay, sân có đèn chiếu sáng tốt\",\n  \"limit\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courts/ai/suggest",
              "host": ["{{baseUrl}}"],
              "path": ["courts", "ai", "suggest"]
            },
            "description": "Gợi ý sân dựa trên thời gian"
          }
        },
        {
          "name": "5. AI Suggest Courts - Quality Focus",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Sân tennis chất lượng cao, không quan tâm giá, có huấn luyện viên\",\n  \"limit\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courts/ai/suggest",
              "host": ["{{baseUrl}}"],
              "path": ["courts", "ai", "suggest"]
            },
            "description": "Gợi ý sân tập trung vào chất lượng"
          }
        },
        {
          "name": "6. Generate Court Description",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/courts/:courtId/ai/description",
              "host": ["{{baseUrl}}"],
              "path": ["courts", ":courtId", "ai", "description"],
              "variable": [
                {
                  "key": "courtId",
                  "value": "YOUR_COURT_ID_HERE",
                  "description": "ID của sân cần tạo mô tả"
                }
              ]
            },
            "description": "Tự động tạo mô tả cho sân bằng AI"
          }
        },
        {
          "name": "7. Compare Courts",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courtIds\": [\n    \"COURT_ID_1\",\n    \"COURT_ID_2\",\n    \"COURT_ID_3\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courts/ai/compare",
              "host": ["{{baseUrl}}"],
              "path": ["courts", "ai", "compare"]
            },
            "description": "So sánh nhiều sân bằng AI"
          }
        }
      ]
    },
    {
      "name": "Validation Tests",
      "item": [
        {
          "name": "Error - Empty Prompt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"\",\n  \"limit\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courts/ai/suggest",
              "host": ["{{baseUrl}}"],
              "path": ["courts", "ai", "suggest"]
            },
            "description": "Test validation với prompt rỗng"
          }
        },
        {
          "name": "Error - Prompt Too Short",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"ab\",\n  \"limit\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courts/ai/suggest",
              "host": ["{{baseUrl}}"],
              "path": ["courts", "ai", "suggest"]
            },
            "description": "Test validation với prompt quá ngắn"
          }
        },
        {
          "name": "Error - Invalid Coordinates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Tìm sân bóng đá\",\n  \"userLat\": 999,\n  \"userLng\": 999\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courts/ai/suggest",
              "host": ["{{baseUrl}}"],
              "path": ["courts", "ai", "suggest"]
            },
            "description": "Test validation với tọa độ không hợp lệ"
          }
        },
        {
          "name": "Error - Compare Too Few Courts",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courtIds\": [\"COURT_ID_1\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/courts/ai/compare",
              "host": ["{{baseUrl}}"],
              "path": ["courts", "ai", "compare"]
            },
            "description": "Test validation với ít hơn 2 sân"
          }
        }
      ]
    },
    {
      "name": "Regular Court APIs",
      "item": [
        {
          "name": "Get All Courts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/courts",
              "host": ["{{baseUrl}}"],
              "path": ["courts"]
            },
            "description": "Lấy danh sách tất cả sân"
          }
        },
        {
          "name": "Create Court",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Sân Test",
                  "type": "text"
                },
                {
                  "key": "sportType",
                  "value": "Bóng đá",
                  "type": "text"
                },
                {
                  "key": "location",
                  "value": "Hà Nội",
                  "type": "text"
                },
                {
                  "key": "price",
                  "value": "200.000đ/giờ",
                  "type": "text"
                },
                {
                  "key": "lat",
                  "value": "21.0285",
                  "type": "text"
                },
                {
                  "key": "lng",
                  "value": "105.8542",
                  "type": "text"
                },
                {
                  "key": "emoji",
                  "value": "⚽",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/courts",
              "host": ["{{baseUrl}}"],
              "path": ["courts"]
            },
            "description": "Tạo sân mới"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    }
  ]
}
